{
  "name": "@dsh/rvc",
  "version": "0.2.2",
  "description": "RVC 拟人语音：Heart 情绪适配、QQ 语音条、FullAwake PC ONNX 合成回传与手机本地回退。",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./acoustic": {
      "default": "./lib/acoustic.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/*.py",
    "scripts/*.json",
    "vendor/phone/*.py",
    "vendor/phone/*.sh",
    "vendor/phone/*.md",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "VOICE-AUDITION.md",
    "EDGE-EXPRESSION.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "rvc",
    "voice",
    "tts",
    "heart",
    "dv5"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
