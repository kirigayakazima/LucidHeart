{
  "name": "lucidheart",
  "version": "0.3.3",
  "private": true,
  "description": "LucidHeart (HeartAwake Suite) - Dual-Embodied AI Companion System for Xiaoman & Axing",
  "type": "module",
  "scripts": {
    "test": "pnpm -r --if-present test && node --test test/*.test.mjs",
    "test:heart": "pnpm --filter @dsh/heart test",
    "test:fullawake": "pnpm --filter dsh-fullawake test",
    "test:qq-plus": "pnpm --filter @dsh/qq-plus test",
    "test:rvc": "pnpm --filter @dsh/rvc test",
    "test:sticker-look": "pnpm --filter dsh-sticker-look test",
    "test:memory": "pnpm --filter @dsh/memory test",
    "test:heart-wake": "pnpm --filter dsh-heart-wake test",
    "test:companion": "pnpm --filter dsh-companion test",
    "test:memory-shape": "node --test tools/memory-shape/test/*.test.mjs"
  },
  "keywords": [
    "lucidheart",
    "heartawake",
    "xiaoman",
    "axing",
    "companion",
    "agent",
    "cordis",
    "heart-protocol",
    "fullawake",
    "multimodal",
    "embodiment"
  ],
  "author": "kirigayakazima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirigayakazima/LucidHeart.git"
  }
}
