{
  "manifest_version": 3,
  "name": "LucidHeart Watch Clock",
  "version": "1.2.0",
  "description": "Share the selected Bilibili player's presented frames with the local FullAwake gateway.",
  "action": { "default_title": "LucidHeart 陪看 (点击切换 ON / OFF)" },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.bilibili.com/video/*"],
  "background": { "service_worker": "bridge.js" },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
